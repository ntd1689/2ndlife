// 2ndLife database schema
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooled connection (Supabase: port 6543 with ?pgbouncer=true)
  directUrl = env("DIRECT_URL")     // direct/session connection (port 5432) — used by prisma migrate
}

enum ListingPlan {
  free
  unlimited
}

enum ListingStatus {
  active
  expired
  archived
  deleted
  sold
  removed // hidden by an admin, e.g. after a report — distinct from owner-initiated "archived" so the owner's self-restore can't undo it
}

enum ReportStatus {
  open
  resolved
  dismissed
}

enum MediaType {
  photo
  video
}

enum PaymentType {
  unlimited_listing
  featured
  relist
  top_ad
  vip_ad
}

enum PaymentProvider {
  paypal
  lynk
}

enum PaymentStatus {
  pending
  completed
  failed
  refund_requested
  refunded
}

enum UserType {
  advertiser
  ads_reviewer
}

// Moderation state, orthogonal to the active/expired/sold lifecycle in
// ListingStatus. An ad is publicly visible only when it is both status=active
// and reviewStatus=approved. Existing rows default to approved so going live
// with this feature doesn't hide the whole board; new/edited ads are set to
// pending in code.
enum ReviewStatus {
  pending
  approved
  rejected
  changes_requested
}

enum PremiumTier {
  none
  top
  vip
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified Boolean    @default(false)
  phone         String?    @unique // contact info only — not SMS-verified, entered by the user
  name          String?    // display name (from Google profile when using SSO)
  image         String?    // profile picture URL (from Google profile)
  googleId      String?    @unique // Google account subject id when signed up via SSO
  userType      UserType   @default(advertiser)
  blockedAt     DateTime?  // set by an admin; blocked users can't log in or use their session
  createdAt     DateTime   @default(now())

  listings      Listing[]
  offers        Offer[]
  payments      Payment[]
  reports       Report[]
  favorites     Favorite[]
  pushSubscriptions PushSubscription[]
}

// Web Push subscriptions (one per browser/device) for in-app push notifications.
// Keyed by the browser-provided endpoint; p256dh/auth are the encryption keys.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Short-lived OTP codes for email verification (sent via Resend, no SMS cost)
model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model Parish {
  id       String    @id @default(cuid())
  name     String    @unique
  listings Listing[]
}

model Category {
  id            String         @id @default(cuid())
  name          String         @unique
  subcategories Subcategory[]
  listings      Listing[]
}

model Subcategory {
  id         String    @id @default(cuid())
  name       String
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  listings   Listing[]

  @@unique([categoryId, name])
}

model Listing {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])

  title         String
  description   String
  instagramUrl  String?

  parishId      String
  parish        Parish        @relation(fields: [parishId], references: [id])
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id])
  subcategoryId String
  subcategory   Subcategory   @relation(fields: [subcategoryId], references: [id])

  plan          ListingPlan   @default(free)
  featured      Boolean       @default(false)
  status        ListingStatus @default(active)

  // Moderation workflow (see ReviewStatus). Public visibility requires
  // status=active AND reviewStatus=approved.
  reviewStatus    ReviewStatus @default(approved)
  reviewNote      String?      // reviewer's reason/instructions on reject or changes-requested
  submittedAt     DateTime?    // when the ad last entered the review queue
  reviewedAt      DateTime?    // when a reviewer/admin last actioned it
  reviewedById    String?      // the reviewer/admin who last actioned it
  flaggedForAdmin Boolean      @default(false) // a reviewer escalated this ad for admin attention

  // Manual position weight within a category — lower numbers appear first.
  // Positions 1-10 qualify as VIP, 11-20 as Top (see lib/premium.ts).
  sortOrder     Int           @default(1000)
  premiumTier   PremiumTier   @default(none)
  premiumUntil  DateTime?     // tier expires and reverts to none after this time

  askingPrice   Int?          // JMD, whole dollars — optional; shown as "Asking J$X" when set
  offerEndAt    DateTime?     // optional deadline after which new offers are rejected

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  expiresAt     DateTime?     // set on create for free-plan listings (createdAt + 7 days)
  archivedAt    DateTime?     // set when status -> expired (archive window starts)
  deletedAt     DateTime?     // set when media is permanently removed

  media         ListingMedia[]
  offers        Offer[]
  payments      Payment[]
  reports       Report[]
  views         ListingView[]
  favorites     Favorite[]

  @@index([status])
  @@index([parishId])
  @@index([categoryId, subcategoryId])
  @@index([categoryId, sortOrder])
  @@index([reviewStatus])
}

// A user saving a listing to their favorites. One row per user+listing pair.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

// One row per unique viewer per listing (viewerKey = user id, or a hash of
// IP + user agent for anonymous visitors).
model ListingView {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  viewerKey String
  createdAt DateTime @default(now())

  @@unique([listingId, viewerKey])
}

// Singleton row (id = 1) of admin-tunable marketplace settings.
model AdminSettings {
  id               Int      @id @default(1)
  freeAdDays       Int      @default(30)
  topAdPriceJmd    Int      @default(1500)
  topAdDays        Int      @default(7)
  vipAdPriceJmd    Int      @default(3000)
  vipAdDays        Int      @default(7)
  refundWindowDays Int      @default(7) // how long after payment an advertiser may request a refund
  signupsEnabled   Boolean  @default(true) // admin kill-switch for new advertiser account creation
  updatedAt        DateTime @updatedAt
}

model ListingMedia {
  id         String    @id @default(cuid())
  listingId  String
  listing    Listing   @relation(fields: [listingId], references: [id])
  type       MediaType
  url        String
  sizeBytes  Int
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([listingId, sortOrder])
}

// Price proposals from buyers. The site never processes the item payment —
// the seller reviews offers and formally accepts one, which marks the listing
// sold and reveals the seller's contact info to that buyer only.
model Offer {
  id          String    @id @default(cuid())
  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id])
  buyerId     String
  buyer       User      @relation(fields: [buyerId], references: [id])
  amount      Int       // JMD
  acceptedAt  DateTime? // set when the seller accepts this offer
  createdAt   DateTime  @default(now())

  @@index([listingId])
}

model Payment {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  listingId       String?
  listing         Listing?        @relation(fields: [listingId], references: [id])

  type            PaymentType
  provider        PaymentProvider
  amountJmd       Int
  premiumDays     Int?            // for top_ad/vip_ad: duration purchased, snapshotted at order time
  providerRef     String?         // PayPal order id / Lynk transaction id
  status          PaymentStatus   @default(pending)

  createdAt       DateTime        @default(now())
  completedAt     DateTime?

  // Refund lifecycle: advertiser requests within the admin-set window,
  // admin approves (money returned via provider, perk reverted) or denies
  // (status returns to completed; requestedAt kept as history).
  refundReason      String?
  refundRequestedAt DateTime?
  refundedAt        DateTime?
}

model Report {
  id         String       @id @default(cuid())
  listingId  String
  listing    Listing      @relation(fields: [listingId], references: [id])
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id])
  reason     String
  status     ReportStatus @default(open)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@index([listingId])
}
