# Database
#
# Two databases are used, kept separate so local testing never touches live data:
#   - LOCAL DEV  -> .env / .env.local  (a dev database; the project uses Neon)
#   - PRODUCTION -> Vercel Production env vars + .env.production.local
#
# .env / .env.local point DATABASE_URL and DIRECT_URL at the DEV database, so
# `npm run dev`, `npm run db:push`, `npm run db:seed`, and one-off scripts all
# hit dev. Deployed production reads its own DATABASE_URL from Vercel's
# Production environment (Supabase). Vercel Preview/Development envs point at dev.
#
# To apply a schema change or seed to the LIVE database, use the :prod scripts,
# which read .env.production.local (create it from your production connection
# strings — it is gitignored):
#   npm run db:push:prod     # push schema to production
#   npm run db:seed:prod     # seed parishes/categories to production
#
# DATABASE_URL is the pooled "transaction mode" string; on Vercel/serverless add
# ?pgbouncer=true&connection_limit=1 (Supabase). DIRECT_URL is the direct/session
# connection prisma migrate/db push uses. For a Neon dev DB a single URL works
# for both.
DATABASE_URL="postgresql://USER:PASSWORD@DEV-DB-HOST/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DEV-DB-HOST/DBNAME?sslmode=require"

# Session signing secret — generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Resend (email OTP) — while this is empty, OTP codes are just printed to the
# server console instead of emailed, which is fine for local dev.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""          # e.g. "2ndLife <noreply@2ndlifejm.net>" once your domain is verified in Resend

# Cloudflare R2 (S3-compatible object storage for photos/video)
R2_ENDPOINT=""                # https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="2ndlife-media"
R2_PUBLIC_BASE_URL=""         # your R2 public bucket URL or custom CDN domain in front of it

# PayPal
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox"          # "sandbox" while testing, "live" once approved for production
JMD_TO_USD_RATE="0.0064"      # update periodically — PayPal settles in USD, not JMD

# PayPal webhook signature verification — from developer.paypal.com → your
# app → Webhooks → (create one subscribed to "Checkout order approved" and
# "Payment capture completed", pointed at /api/payments/paypal/webhook).
# Required: the webhook route throws without it.
PAYPAL_WEBHOOK_ID=""

# Same PayPal Client ID, exposed to the browser for the PayPal Buttons SDK.
# This one is NOT secret — it's fine that it ends up in client-side JS.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# Lynk — not wired up yet, see lib/payments/lynk.ts. Fill these in once
# LynkBiz issues your merchant credentials.
LYNK_API_KEY=""
LYNK_MERCHANT_ID=""

# Cron job protection — Vercel sets this automatically as the Authorization
# header value when you configure "Protect your Cron Jobs" in project settings
CRON_SECRET="change-me-too"

# Comma-separated emails allowed into /admin (must match a verified account's
# email exactly, case-insensitive). Empty = no one has admin access.
ADMIN_EMAILS=""

# Google SSO (optional) — create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <site origin>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
